<Window x:Class="RemoteGamepadServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteGamepad Server"
        Width="860" Height="660"
        MinWidth="680" MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        Background="#FF0F1117"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FF1A1D28"/>
            <Setter Property="BorderBrush" Value="#FF2A2D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- Section heading -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7080"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Status label -->
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8ECF4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
        </Style>

        <!-- Info label -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8890A4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <!-- Accent dot -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <!-- Button template -->
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border x:Name="bd" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#FF333850"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF4A9EFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#FF1E2130"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Neutral button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF252838"/>
            <Setter Property="Foreground" Value="#FFB0B8C8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderBrush" Value="#FF3A3D4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <!-- Start button (blue accent) -->
        <Style x:Key="StartBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#FF1A3A5C"/>
            <Setter Property="BorderBrush" Value="#FF4A9EFF"/>
            <Setter Property="Foreground" Value="#FF4A9EFF"/>
        </Style>

        <!-- Stop button (red accent) -->
        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#FF3C1A1A"/>
            <Setter Property="BorderBrush" Value="#FF5A3A3A"/>
            <Setter Property="Foreground" Value="#FFE06060"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE74C3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark scrollbar -->
        <Style x:Key="DarkScroll" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9"
                            Background="#FF1A3A5C" BorderBrush="#FF4A9EFF" BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="🎮" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RemoteGamepad Server" 
                                   Foreground="#FFE8ECF4" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Virtual controller server" 
                                   Foreground="#FF6B7080" FontSize="11.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,7,0"
                             Fill="#FF2ECC71" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="RUNNING" 
                               Foreground="#FF2ECC71" FontSize="12.5" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATUS CARDS ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bluetooth -->
            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,5,5">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHead}" Text="BLUETOOTH"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BtDot" Style="{StaticResource Dot}" Fill="#FF2ECC71"/>
                        <TextBlock x:Name="BtStatus" Text="Listening" Style="{StaticResource StatusLabel}"/>
                    </StackPanel>
                    <TextBlock x:Name="BtRadio" Text="Radio: —" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="BtAddress" Text="Address: —" Style="{StaticResource InfoLabel}"/>
                </StackPanel>
            </Border>

            <!-- Wi-Fi -->
            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorder}" Margin="5,0,0,5">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHead}" Text="WI-FI"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="WifiDot" Style="{StaticResource Dot}" Fill="#FF2ECC71"/>
                        <TextBlock x:Name="WifiStatus" Text="Listening" Style="{StaticResource StatusLabel}"/>
                    </StackPanel>
                    <TextBlock Text="Input port: 26760" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Text="Discovery port: 26761" Style="{StaticResource InfoLabel}"/>
                </StackPanel>
            </Border>

            <!-- Virtual controller -->
            <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,5,5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHead}" Text="VIRTUAL CONTROLLER"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="VcDot" Style="{StaticResource Dot}" Fill="#FF2ECC71"/>
                        <TextBlock x:Name="VcStatus" Text="Xbox 360 — Connected" Style="{StaticResource StatusLabel}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Connected client -->
            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="5,5,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHead}" Text="CONNECTED CLIENT"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ClientDot" Style="{StaticResource Dot}" Fill="#FF555A6A"/>
                        <TextBlock x:Name="ClientStatus" Text="No client connected" Style="{StaticResource StatusLabel}"/>
                    </StackPanel>
                    <TextBlock x:Name="ClientTransport" Text="" Style="{StaticResource InfoLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ SERVER LOG ═══ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FF151820" CornerRadius="8,8,0,0" Padding="14,8">
                    <TextBlock Text="SERVER LOG" Style="{StaticResource SectionHead}" Margin="0"/>
                </Border>
                <Border Grid.Row="1" Background="#FF0D0F16" CornerRadius="0,0,8,8">
                    <ScrollViewer x:Name="LogScroll" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,8">
                        <TextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 Foreground="#FF8890A4"
                                 FontFamily="Consolas" FontSize="12"
                                 BorderThickness="0"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ CONTROLS ═══ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
            <Button x:Name="BtnStart" Content="▶  Start Server" 
                    Style="{StaticResource StartBtn}"
                    Click="BtnStart_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnStop" Content="■  Stop Server" 
                    Style="{StaticResource StopBtn}"
                    Click="BtnStop_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnDisconnect" Content="⊘  Disconnect Client" 
                    Style="{StaticResource ActionBtn}"
                    Click="BtnDisconnect_Click"/>
        </StackPanel>
    </Grid>
</Window>
