<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="900dp"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#20242B"
                android:endColor="#0A0C10" />
        </shape>
    </item>
    <!-- Subtle top panel seam, purely cosmetic depth cue. -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#00000000" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>
